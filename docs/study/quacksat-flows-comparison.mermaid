flowchart LR
    subgraph DUCK["🦆 Microduck — quacksat (same in all three cases)"]
        direction TB
        MIC["🎤 mic"] --> WW["local wake word<br/>+ VAD"]
        WW --> TX["transport<br/>(interchangeable backend)"]
        RX["return audio"] --> SPK["🔊 speaker via sound.rs"]
        TOOLS["local tools<br/>quack · head · intents → robotd"]
    end

    TX -- "A: Wyoming/ESPHome" --> HA
    TX -- "B: WebSocket" --> BRIDGE_B
    TX -- "C: WebSocket" --> BRIDGE_C

    subgraph A["A — Home Assistant pipeline"]
        direction LR
        HA["HA Assist<br/>pipeline"] --> STT_A["STT<br/>Speech-to-Phrase / Whisper"]
        STT_A --> INT{"local<br/>intent?"}
        INT -- "yes (0.17 s)" --> ACT_A["HA action"]
        INT -- "no" --> SHIM["OpenAI shim<br/>→ Arkimede"]
        SHIM --> MCP_A["MCP → HA"]
        ACT_A --> TTS_A["Piper TTS"]
        SHIM --> TTS_A
    end
    TTS_A --> RX

    subgraph B["B — Direct agent, cascaded"]
        direction LR
        BRIDGE_B["quacksat bridge<br/>(on the server)"] --> STT_B["streaming STT<br/>faster-whisper"]
        STT_B --> AGENT["Arkimede / Claude<br/>LLM + tool calling"]
        AGENT --> T_HA["tool: HA via MCP"]
        AGENT --> T_ROBOT["tool: robotd<br/>move · head · skill"]
        AGENT --> TTS_B["streaming TTS<br/>Piper / Kokoro / cloud"]
    end
    TTS_B --> RX
    T_ROBOT -.-> TOOLS

    subgraph C["C — Direct agent, speech-to-speech"]
        direction LR
        BRIDGE_C["thin bridge"] --> RT["realtime API<br/>audio ↔ audio<br/>(OpenAI Realtime, Gemini Live)"]
        RT --> T_RT["tool calling<br/>→ HA / robotd"]
    end
    RT --> RX

    classDef local fill:#e8f5e9,stroke:#2e7d32
    classDef cloud fill:#fff3e0,stroke:#ef6c00
    class HA,STT_A,INT,ACT_A,SHIM,MCP_A,TTS_A,BRIDGE_B,STT_B,AGENT,T_HA,T_ROBOT,TTS_B local
    class RT,T_RT cloud
