[Unit]
Description=quack-navd — the Microduck's navigation daemon
# After, not Requires/BindsTo: a down robotd must not keep the daemon
# from starting and retrying — it reconnects in-process, and a tool says
# so meanwhile (the padd pattern, ADR 0003).
After=robotd.service local-fs.target
Wants=robotd.service

[Service]
Type=exec
ExecStart=/usr/local/bin/quack-navd /etc/robot/quack-nav.toml
Restart=always
RestartSec=5s
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal

# Unprivileged (padd pattern): `robot` reaches robotd's 0660 socket and
# tofd's. No audio: this daemon has nothing to say.
User=quacknav
Group=quacknav
SupplementaryGroups=robot
# /run/quack-nav/nav.sock and map.sock: under ProtectSystem=strict this is
# the one place in /run the daemon may create a file. It hands both to the
# `robot` group at 0660, as robotd and tofd do theirs, so quacksat (or any
# caller in `robot`) can connect.
RuntimeDirectory=quack-nav
StateDirectory=quack-nav

# Resource fence: the navigation must never cost robotd its 50 Hz loop.
# robotd runs at nice 0 with no real-time class (daemon-v0.14.4). This
# daemon walks the duck, so it sits at 5, not lower — the explorer steers
# and the cliff guard must answer in time — and the maploc worker lowers
# its own thread by 5 more (src/mapd/mod.rs), nice 10, where the fork ran
# it inside robotd: a relocalize search or a map_match is seconds of a
# full core. CPUWeight 70 (of 100) trims our share under contention. Memory: ~20 MB
# resident after four minutes of mapping on the twin (2026-09-23); the
# caps leave room for a house many times that and for map_match, which
# renders every saved map.
Nice=5
CPUWeight=70
MemoryHigh=256M
MemoryMax=320M

# Hardening block copied from padd.service. Unix sockets only: robotd,
# tofd, and the callers of this daemon's own two.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
